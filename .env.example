# MySQL 資料庫連線設定
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=tutorlink

# JWT 會員身分驗證設定
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AWS S3 - 老師頭貼儲存設定
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-east-2
AWS_S3_BUCKET=

# 綠界 ECPay 第三方付款設定（Sandbox 測試環境）
ECPAY_ENV=stage
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_PAYMENT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# 綠界 Sandbox 測試信用卡
# 僅供本機開發與測試使用
ECPAY_TEST_CARD_NUMBER=
ECPAY_TEST_CARD_EXPIRY=
ECPAY_TEST_CARD_CVV=